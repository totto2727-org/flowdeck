{
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node-ts/tsconfig.json"],
  "contentMappers": [{ "package": "reylo", "extensions": [".sql", ".reylo.yaml", ".reylo.yml"] }],
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "@cloudflare/workers-types", "vite/client"],
    "paths": { "@/*": ["./src/workers/frontend/features/*"] }
  },
  "exclude": ["tmp", "node_modules", "migrations"]
}
